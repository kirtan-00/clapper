# Copy to .env and fill in. Never commit the real file.
#
# The BROWSER never sees either of these. razorpay-order returns the key id to
# the checkout modal at runtime, which is deliberate: the key that opens the
# modal is then guaranteed to be the same key that created the order. A
# build-time VITE_RAZORPAY_KEY_ID would be a second copy that can drift, and a
# drift there fails the payment at the modal with a confusing error.
#
# Set the real values as Supabase function secrets, not in any build:
#   supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=...

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
