# ---------------------------------------------------------------------------
# Senchine AI configuration. Copy to `.env` and adjust. Every value has a
# working default, so the platform boots with zero configuration.
# ---------------------------------------------------------------------------

# --- Core ---
SENCHINE_DB=./senchine.db
SENCHINE_HOST=0.0.0.0
SENCHINE_PORT=8000

# --- Auth ---
# Generated per-boot if unset. Set it in production so tokens survive restarts.
SENCHINE_JWT_SECRET=
SENCHINE_TOKEN_TTL_MIN=720

# --- Simulation ---
# Sensor sampling interval (seconds) and agent pipeline cadence (ticks).
SENCHINE_TICK_SECONDS=2.0
SENCHINE_PIPELINE_EVERY=3

# --- AI Copilot (optional) ---
# With a key: grounded natural-language answers from Claude.
# Without a key: the deterministic grounded composer answers from the same
# retrieved evidence. Both paths cite sources; neither invents numbers.
ANTHROPIC_API_KEY=
SENCHINE_LLM_MODEL=claude-opus-5
SENCHINE_LLM_EFFORT=low
SENCHINE_LLM_MAX_TOKENS=1400
# Cache identical copilot questions for N seconds (0 disables).
SENCHINE_LLM_CACHE_TTL=300
